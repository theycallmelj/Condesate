# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored (see .gitignore) so secrets never get committed.
#
# Used by `cargo run -p chat-app --features remote` (crates/chat-app/src/main.rs).

# anthropic | openai — leave unset (or anything else) to fall back to the offline echo provider.
PROVIDER=anthropic

# Only the key matching PROVIDER needs a real value.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional — defaults to claude-sonnet-4-6 (anthropic) / gpt-4o (openai) if unset.
MODEL=claude-sonnet-4-6

# Used by `cargo run -p leader-search` (crates/leader-search/src/main.rs).
# Optional — appends every permission check to this file, in addition to the
# live stderr trail. Leave unset for no file (see crates/leader-search/README.md).
AUDIT_LOG_PATH=./audit.log

# Used by `cargo run -p mnemosyne` (crates/mnemosyne/src/main.rs).
# Optional — the two agents run different models on purpose; override either
# independently if your account doesn't have access to one of these exact ids.
MAIN_MODEL=claude-opus-4-6
MORPHEUS_MODEL=claude-sonnet-4-6
# Optional — cadence in turns (see crates/mnemosyne/README.md). Defaults: 10 / 20.
CURATE_EVERY=10
RESET_EVERY=20
# Optional — port for the read-only diagnostic API the crates/mnemosyne/dashboard
# React app polls. Default: 4477.
API_PORT=4477
# Optional — uncomment to auto-start the dashboard's dev server (npm install
# if needed) and open it in your browser. Independent of VERBOSE. Left
# commented here on purpose: unlike the other lines above, this one has a
# visible side effect (opening a browser tab) that shouldn't happen just
# because someone copied this file without reading it.
#DEBUG=1
# Optional — port for the dashboard's own dev server, only used when DEBUG is set.
DASHBOARD_PORT=5183
