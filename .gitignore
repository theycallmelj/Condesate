# Rust build artifacts
/target
**/target

# evals run output (table/json/csv/dashboard) — regenerated by `cargo run -p evals`
/evals-out
**/evals-out

# real harness-evals run output — regenerated by `cargo run -p evals --bin harness_evals_run`
crates/evals/harness_evals/results.jsonl

# real condesate trajectory dump — regenerated by `cargo run -p evals --bin agentevals_run`
crates/evals/agent_evals/trajectory.json

# Python venv created by crates/evals/run-all.sh
crates/evals/.venv

# Backtrace / debug
*.pdb

# Env files with secrets (API keys) — .env.example is a committed template
.env
.env.*
!.env.example

# leader-search's AUDIT_LOG_PATH default (see .env.example)
/audit.log

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/
